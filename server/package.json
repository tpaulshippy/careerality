{
  "name": "careerality-api",
  "version": "1.0.0",
  "private": true,
  "description": "Careerality API — Hono + drizzle-orm on Cloudflare Workers (D1/SQLite)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply careerality --local",
    "db:migrate:remote": "wrangler d1 migrations apply careerality --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@libsql/client": "^0.15.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0",
    "wrangler": "4.153.0"
  }
}
