# Copy to .dev.vars for `wrangler dev` (never commit secrets).
# Local Expo web runs on :8081, so it is allowlisted for development only;
# production CORS_ORIGINS in wrangler.toml stays limited to careerality.app.
CORS_ORIGINS="https://careerality.app,http://localhost:8081"
TYPESAFE_API_BASE="https://api.typesafe.ai"
JEV_MODEL="jev-latest"
# TYPESAFE_API_KEY="<typesafe-key>"
